# =========================================================================
# 🔱 Shri Ram Naam Jap Counter - Backend Environment Configuration
# =========================================================================

# --- SERVER CONFIGURATION ---
# PORT: On Render, this is provided automatically (defaults to 10000 or dynamic).
# For local development: 5000
PORT=5000

# NODE_ENV: Set to 'production' on Render
NODE_ENV=production

# NODE_VERSION: Render requires Node.js >= 22 for native SQLite (node:sqlite)
NODE_VERSION=22

# --- JWT SECURITY CONFIGURATION ---
# Generate a secure 256-bit secret for production: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# --- FRONTEND CORS & REDIRECT CONFIGURATION ---
# Set this to your deployed frontend domain (e.g. on Vercel)
# Format: https://your-app-name.vercel.app (do NOT add trailing slash)
FRONTEND_URL=https://your-frontend-app.vercel.app
CLIENT_URL=https://your-frontend-app.vercel.app

# --- DATABASE PERSISTENCE CONFIGURATION ---
# The backend uses Node.js native SQLite (node:sqlite) with WAL mode.
# Option 1 (Render Free Tier): Default local file (ephemeral - resets on server spin down/deploy)
# DB_PATH=ramjap.sqlite
#
# Option 2 (Render Persistent Disk - Recommended for production):
# Attach a Render Persistent Disk mounted at /var/data and set:
DB_PATH=/var/data/ramjap.sqlite

# =========================================================================
# 📧 EMAIL SMTP CONFIGURATION (For Real OTP Delivery to User's Inbox)
# =========================================================================
# If left blank, the platform runs in Development Mode (OTP codes are logged
# to the terminal and shown on the verification screen for instant local testing).
#
# --- OPTION A: GMAIL (Recommended for personal/fast setup) ---
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#    (Select App name: "Ram Jap Counter")
# 3. Enter your Gmail and 16-character password below (spaces are automatically handled):
#
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_google_app_password
# SMTP_FROM=Shri Ram Naam Jap <your_email@gmail.com>
#
# --- OPTION B: RESEND (Professional Developer SMTP) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_actual_api_key
# SMTP_FROM=Shri Ram Naam Jap <onboarding@resend.dev>
#
# --- OPTION C: BREVO / SENDINBLUE ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login@example.com
# SMTP_PASS=your_brevo_smtp_key
# SMTP_FROM=Shri Ram Naam Jap <verified_sender@example.com>
# =========================================================================

# Active SMTP Settings:
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Shri Ram Naam Jap <noreply@ramjap.org>

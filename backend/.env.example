# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Session & Tokens (Generate in production with: openssl rand -base64 32)
JWT_SECRET=dev_shri_ram_jap_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Frontend Web Application URL (used for email verification & reset links)
CLIENT_URL=http://localhost:5173

# SQLite Database File Path (Leave blank to use default ramjap.sqlite)
DB_PATH=ramjap.sqlite

# =========================================================================
# 📧 EMAIL SMTP CONFIGURATION (For Real OTP Delivery to User's Inbox)
# =========================================================================
# If left blank, the platform runs in Development Mode (OTP codes are logged
# to the terminal and shown on the verification screen for instant local testing).
#
# --- OPTION A: GMAIL (Recommended for personal/fast setup) ---
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#    (Select App name: "Ram Jap Counter")
# 3. Enter your Gmail and 16-character password below (spaces are automatically handled):
#
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_google_app_password
# SMTP_FROM=Shri Ram Naam Jap <your_email@gmail.com>
#
# --- OPTION B: RESEND (Professional Developer SMTP) ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_actual_api_key
# SMTP_FROM=Shri Ram Naam Jap <onboarding@resend.dev>
#
# --- OPTION C: BREVO / SENDINBLUE ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login@example.com
# SMTP_PASS=your_brevo_smtp_key
# SMTP_FROM=Shri Ram Naam Jap <verified_sender@example.com>
# =========================================================================

